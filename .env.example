# Used to encrypt brain dumps and sign rate-limit identifiers at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Optional: comma-separated list of previous secrets to allow seamless key rotation.
APP_PREVIOUS_SECRETS=

# Optional: secret key to protect the automated background cleanup endpoint (/api/cron/cleanup).
CRON_SECRET=

# SQLite database location. Use a persistent volume in deployment.
DATABASE_PATH=./data/clearstep.db

# Optional: any OpenAI-compatible chat-completions provider.
# Without these, Clearstep runs in manual planning mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER_NAME=OpenAI

# Optional fallback provider, used when the primary provider fails.
# Example: Google AI Studio's OpenAI-compatible endpoint.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-3.5-flash
LLM_FALLBACK_PROVIDER_NAME=Google AI Studio
